# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_UPLOAD_SIZE=26214400

# AI Integration (optional - for AI-powered PDF features)
# AI_API_KEY must be set in the Render dashboard (not in render.yaml) or
# locally in .env. Use a Groq API key from https://console.groq.com
AI_API_KEY=
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
# llama-3.3-70b-versatile was deprecated by Groq (shutdown: 2026-08-16).
# The recommended replacement is openai/gpt-oss-120b or openai/gpt-oss-20b.
AI_DEFAULT_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# OCR (optional - requires Tesseract system package)
TESSERACT_CMD=

# CSRF Protection (comma-separated list)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (PostgreSQL example, set to use SQLite by default)
DATABASE_URL=sqlite:///db.sqlite3