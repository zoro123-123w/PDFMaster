# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_UPLOAD_SIZE=26214400

# AI Integration (optional - for AI-powered PDF features)
AI_API_KEY=your_api_key_here
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_DEFAULT_MODEL=llama-3.3-70b-versatile

# OCR (optional - requires Tesseract system package)
TESSERACT_CMD=

# CSRF Protection (comma-separated list)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (PostgreSQL example, set to use SQLite by default)
DATABASE_URL=sqlite:///db.sqlite3