# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
MAX_UPLOAD_SIZE=26214400

# AI Integration (optional - for AI-powered PDF features)
# AI_API_KEY must be set in the Render dashboard (not in render.yaml) or
# locally in .env. Use a Groq API key from https://console.groq.com
AI_API_KEY=
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
# llama-3.3-70b-versatile was deprecated by Groq (shutdown: 2026-08-16).
# The recommended replacement is openai/gpt-oss-120b or openai/gpt-oss-20b.
AI_DEFAULT_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# OCR (optional - requires Tesseract system package)
TESSERACT_CMD=

# CSRF Protection (comma-separated list)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Site branding / SEO (used for canonical URLs, Open Graph, sitemap, robots.txt)
SITE_URL=https://yourdomain.com

# Ads (optional). Leave ADSENSE_CLIENT_ID empty to render no ad slots at all.
ADSENSE_CLIENT_ID=
# AdSense slot IDs for the built-in banner positions (leaderboard below content,
# inline inside tool pages).
AD_SLOT_LEADERBOARD=
AD_SLOT_INLINE=

# Ad-gate (optional interstitial). Opens in a NEW TAB on "Download" and
# "Start OCR" clicks; the current page is never redirected. No-op when
# AD_GATE_ENABLED is false or AD_GATE_URL is empty. Per-tab cooldown in minutes.
AD_GATE_ENABLED=False
AD_GATE_URL=
AD_GATE_COOLDOWN_MIN=10

# Database (SQLite by default; point SQLITE_PATH at a volume in Docker)
# DATABASE_URL is not parsed; use SQLITE_PATH to relocate the SQLite file.
SQLITE_PATH=